# Frontend (Vite) — copy to .env.local, or set in Vercel → Project → Settings → Environment Variables
# Production: use your Convex *production* URL (from `npx convex deploy`) and Clerk *live* publishable key.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Convex dashboard → Settings → Environment variables
CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
OPENAI_API_KEY=
ADMIN_EMAILS=you@example.com

# Stripe (optional — Pro checkout + webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_...
APP_ORIGIN=http://localhost:5173

# --- Vercel + production ---
# 1. Connect the repo; Framework Preset: Vite (vercel.json sets build + SPA rewrites).
# 2. Add VITE_CONVEX_URL and VITE_CLERK_PUBLISHABLE_KEY for Production (and Preview if you want previews to work).
# 3. Deploy Convex: npx convex deploy — then copy the production deployment URL into VITE_CONVEX_URL.
# 4. Clerk Dashboard → your app → Domains: add your Vercel domain (*.vercel.app and custom).
# 5. Convex dashboard → set APP_ORIGIN to https://your-app.vercel.app (and Stripe redirect URLs if using Pro).
